# ── Database ──
POSTGRES_USER=davax
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=davax_automotive
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Firebase ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=AIzaSyDEV_TEST_KEY_REPLACE_ME
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
# Deliberately no GOOGLE_APPLICATION_CREDENTIALS. Verifying ID tokens needs only
# the project ID plus Google's public certs, so no service account key is
# required. Setting it to a path that does not exist in a fresh clone makes the
# Admin SDK's credential lookup raise, and every /auth call fails 500/401.

VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=AIzaSyDEV_TEST_KEY_REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=AIzaSyDEV_MAPS_TEST_KEY_REPLACE_ME
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDEV_MAPS_TEST_KEY_REPLACE_ME
# Not a key, just an ID for themes
VITE_GOOGLE_MAPS_MAP_ID=b6c6ef5e4e072b886d00873f

# ── Mapbox ──
MAPBOX_ACCESS_TOKEN=pk.dev_test_token_replace_me

# ── OpenWeatherMap ──
OPENWEATHERMAP_API_KEY=dev_test_key_replace_me
VITE_OPENWEATHERMAP_API_KEY=dev_test_key_replace_me

# ── Spotify ──
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_CACHE_PATH=.spotify_cache
FRONTEND_URL=http://localhost:5173

# ── App ──
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── JWT (Email/Password Auth) ──
JWT_SECRET_KEY=replace-with-a-long-random-secret-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Gemini (in-car assistant) ──
# No VITE_ twin on purpose: the key must never reach the browser bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
